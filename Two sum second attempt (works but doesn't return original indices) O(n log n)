class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """

        nums.sort()

        min = 0
        max = len(nums) - 1

        while min < max :
            sum = nums[min] + nums[max]

            if sum == target:
                return min,max
            elif sum > target:
                max = max - 1
            else:
                min = min + 1
