class Solution(object):
    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """

        if x < 0 :
            return False
        
        orig = x
        newNum = 0
        while x>0 :
            newNum = newNum * 10 + x%10
            x=x//10
        return newNum == orig

#here I fix the issue of having to reassemble the number by doing it all in one big loop rather than adding the numbers to a list
